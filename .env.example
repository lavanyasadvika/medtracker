# ═══════════════════════════════════════════════════════════════════
# MedTracker – Docker Compose environment
#
# Copy this file to `.env` (same folder as docker-compose.yml) and
# fill in real values. `.env` is gitignored — never commit it.
# Every value here has a safe fallback baked into docker-compose.yml,
# so `docker compose up --build` works with zero setup; fill these in
# only to point at real services (a real Groq key, real SMTP, etc).
# ═══════════════════════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────────────────
DB_NAME=medtracker
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── JWT ─────────────────────────────────────────────────────────
# Generate your own 256-bit secret for anything beyond local demo use, e.g.:
#   openssl rand -base64 32
JWT_SECRET=

# ── Groq AI (label-photo scan) — https://console.groq.com ───────
# Leave GROQ_API_KEY blank + GROQ_MOCK_ENABLED=true to run the scan
# flow without a real key (returns a canned "Mock Medicine" result).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_MOCK_ENABLED=true

# ── Mailtrap / SMTP (expiry & low-stock alert emails) ────────────
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@medtracker.local

# ── Actuator ──────────────────────────────────────────────────────
ACTUATOR_PASSWORD=actuator-dev

# ── Frontend ──────────────────────────────────────────────────────
# Browser-facing URL of the backend (baked into the frontend at build time)
VITE_API_URL=http://localhost:8080/api

# ── Observability (Grafana / Prometheus / Zipkin) ────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Fraction of requests traced (1.0 = all — fine for local/demo, lower for real load)
TRACING_SAMPLING_PROBABILITY=1.0
