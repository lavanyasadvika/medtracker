# ═══════════════════════════════════════════════════════════════════
# MedTracker – Azure deployment configuration
#
# Copy to azure/azure.env and fill in real values. azure/azure.env is
# gitignored — never commit it.
#
# Used by azure/setup-infra.sh (one-time) and azure/deploy.sh (every
# redeploy).
# ═══════════════════════════════════════════════════════════════════

# ── Where ─────────────────────────────────────────────────────────
RESOURCE_GROUP=medtracker-rg
LOCATION=eastus

# Must be globally unique across all of Azure (letters/numbers only, 5-50 chars)
ACR_NAME=medtrackeracr2026

# Must be globally unique across *.azurecontainer.io
DNS_LABEL=medtracker-app-2026

# ── Database ─────────────────────────────────────────────────────
# Postgres runs as a plain container inside the app's container group
# (no managed Azure DB, no persistent volume — see azure/infra.bicep for
# why). Data resets on every redeploy.
DB_NAME=medtracker
DB_USERNAME=postgres
DB_PASSWORD=ChangeMe_UseAStrongPassword123!

# ── Application secrets ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=ChangeMe_GenerateWithOpensslRandBase64_32
ACTUATOR_PASSWORD=ChangeMe_ActuatorPassword

# Grafana admin login password (username stays "admin")
GRAFANA_ADMIN_PASSWORD=ChangeMe_GrafanaPassword

# ── Optional integrations (leave blank to keep GROQ mocked) ──────
GROQ_API_KEY=
GROQ_MOCK_ENABLED=true

SMTP_USERNAME=
SMTP_PASSWORD=
